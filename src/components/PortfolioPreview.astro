---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}`}>
	<div class="card-img-wrap">
		<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" style={data.img_position ? `object-position: ${data.img_position}` : undefined} />
	</div>
	<div class="card-body">
		<h3 class="title">{data.title}</h3>
		{data.description && <p class="description">{data.description}</p>}
		{data.tags && data.tags.length > 0 && (
			<div class="card-tags">
				{data.tags.map((tag) => <span class="card-tag">{tag}</span>)}
			</div>
		)}
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition:
			box-shadow 0.3s ease,
			transform 0.3s ease;
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-4px);
	}

	.card-img-wrap {
		overflow: hidden;
	}

	img {
		width: 100%;
		height: 12rem;
		object-fit: cover;
		object-position: top center;
		display: block;
		transition: transform 0.4s ease;
	}

	.card:hover img {
		transform: scale(1.03);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}

	.title {
		margin: 0;
		color: var(--gray-0);
		font-family: var(--font-brand);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.3;
	}

	.description {
		margin: 0;
		color: var(--gray-300);
		font-size: var(--text-sm);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.card-tag {
		padding: 0.2rem 0.55rem;
		font-size: 0.75rem;
		font-family: var(--font-body);
		font-weight: 500;
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		border-radius: 999rem;
		line-height: 1.35;
	}

	@media (min-width: 50em) {
		.card {
			border-radius: 1.5rem;
		}

		.card-body {
			padding: 1.25rem;
		}

		.title {
			font-size: var(--text-lg);
		}

		img {
			height: 18rem;
		}

		.card-tag {
			padding: 0.25rem 0.65rem;
			font-size: var(--text-sm);
		}
	}
</style>
