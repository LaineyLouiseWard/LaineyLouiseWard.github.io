---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}`}>
	<h3 class="title">{data.title}</h3>
	<div class="card-img-wrap">
		<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" style={data.img_position ? `object-position: ${data.img_position}` : undefined} />
	</div>
	{data.tags && data.tags.length > 0 && (
		<div class="card-tags">
			{data.tags.map((tag) => <span class="card-tag">{tag}</span>)}
		</div>
	)}
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.title {
		margin: 0;
		padding: 1rem 1rem 1.5rem;
		color: var(--gray-200);
		font-family: var(--font-brand);
		font-size: var(--text-base);
		font-weight: 600;
	}

	.card-img-wrap {
		overflow: hidden;
	}

	img {
		width: 100%;
		height: 12rem;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.75rem 1rem;
	}

	.card-tag {
		padding: 0.25rem 0.65rem;
		font-size: var(--text-sm);
		font-family: var(--font-body);
		font-weight: 500;
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		border-radius: 999rem;
		line-height: 1.35;
	}

	@media (min-width: 50em) {
		.card {
			border-radius: 1.5rem;
		}

		.title {
			padding: 1.25rem 1.25rem 1.5rem;
			font-size: var(--text-lg);
		}

		img {
			height: 18rem;
		}

		.card-tags {
			padding: 0.75rem 1.25rem 1rem;
		}
	}
</style>
