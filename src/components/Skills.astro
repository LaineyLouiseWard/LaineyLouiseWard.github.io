---
import Icon from './Icon.astro';
---

<section class="box skills">
	<div class="stack gap-2 lg:gap-4">
		<div class="icon-circle">
			<Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
		</div>
		<h2>Climate & Weather AI</h2>
		<p>Machine learning approaches for subseasonal-to-seasonal forecasting and extreme weather prediction.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<div class="icon-circle">
			<Icon icon="terminal-window" color="var(--accent-regular)" size="2.5rem" gradient />
		</div>
		<h2>Forecast Data Analysis</h2>
		<p>Working with meteorological datasets, reanalysis products, and forecast data in Python.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<div class="icon-circle">
			<Icon icon="pencil-line" color="var(--accent-regular)" size="2.5rem" gradient />
		</div>
		<h2>Science Communication</h2>
		<p>Research presentations, written reports, visualisations, and undergraduate teaching.</p>
	</div>
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
		transition: box-shadow 0.3s ease, transform 0.3s ease;
	}

	.box:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-3px);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
	}

	.icon-circle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		background: var(--accent-subtle-overlay);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5rem;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
