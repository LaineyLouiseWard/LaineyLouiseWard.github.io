---
const profile = 'https://github.com/LaineyLouiseWard';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0; url=${profile}`} />
		<link rel="canonical" href={profile} />
		<meta name="robots" content="noindex" />
		<title>Lainey Ward</title>
		<script is:inline define:vars={{ profile }}>window.location.replace(profile);</script>
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
				background: #0b1622;
				color: #e6edf5;
				text-align: center;
				padding: 1.5rem;
			}
			a { color: #7fb2e5; }
		</style>
	</head>
	<body>
		<p>
			This site is being rebuilt.<br />
			Redirecting you to <a href={profile}>my GitHub</a>&hellip;
		</p>
	</body>
</html>
