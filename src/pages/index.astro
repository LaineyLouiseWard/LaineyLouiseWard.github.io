---
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-30">
		<div class="wrapper stack gap-8 lg:gap-15">
			<header class="hero">
				<Hero
					title="PhD Researcher"
					tagline="PhD researcher and Innovate for Ireland iScholar at the UCD Decarb-AI Centre, studying subseasonal-to-seasonal predictability of multi-hazard weather and climate events using machine learning."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="strategy" size="1.33em" /> Artificial Intelligence</Pill>
						<Pill><Icon icon="terminal-window" size="1.33em" /> Weather & Climate</Pill>
						<Pill><Icon icon="code" size="1.33em" /> Hazards</Pill>
					</div>
					<p class="hero-detail">
						See what I'm working on below.
					</p>
				</Hero>

				<img
					alt="Lainey Ward"
					width="480"
					height="620"
					src="/assets/portrait.jpg"
					loading="eager"
					fetchpriority="high"
				/>
			</header>

			<Skills />

			<div class="research-card">
				<div class="research-label">Current PhD Research</div>
				<h3 class="research-title">Subseasonal-to-Seasonal Prediction of Multi-Hazard Weather Events</h3>
				<p class="research-org">University College Dublin · Decarb-AI Centre · Innovate for Ireland iScholar</p>
				<p class="research-desc">Investigating sources of predictability at 2–8 week lead times for compound hydroclimatic extremes — including drought-to-flood and flood-to-drought transitions — and evaluating how current forecast systems (ECMWF SEAS5) can support early warning and climate-informed decision-making over Ireland.</p>
				<div class="research-tags">
					<span class="research-tag">ECMWF SEAS5</span>
					<span class="research-tag">ERA5 Reanalysis</span>
					<span class="research-tag">Forecast Verification</span>
					<span class="research-tag">Compound Extremes</span>
					<span class="research-tag">MJO & Teleconnections</span>
				</div>

				<div class="research-interests">
					<h4 class="research-interests-heading">Research Interests</h4>
					<div class="interests-row">
						<span class="interest-pill">Weather Extremes</span>
						<span class="interest-pill">Seasonal Forecasting</span>
						<span class="interest-pill">Floods & Droughts</span>
						<span class="interest-pill">Green Energy</span>
						<span class="interest-pill">Impacts & Hazards</span>
						<span class="interest-pill">Science Communication</span>
						<span class="interest-pill">Community Building</span>
					</div>
				</div>
			</div>
		</div>

		<main class="wrapper stack gap-20 lg:gap-30">
			<!-- 1. Projects -->
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>Projects</h2>
					<p>Selected projects in AI, meteorology, and scientific communication.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<!-- 2. Publications -->
			<section id="publications" class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>Publications</h2>
				</header>

				<div class="gallery">
					<div class="publications">
						<div class="pub-item">
							<img class="pub-img" src="/assets/publication.gif" alt="Molecular dynamics simulation of water harvesting by ionic liquids" loading="lazy" />
							<div class="pub-body">
								<h4>Water Harvesting by Thermoresponsive Ionic Liquids: A Molecular Dynamics Study of the Water Absorption Kinetics and of the Role of Nanostructuring</h4>
								<p class="pub-authors">Nancy C. Forero-Martinez, Robinson Cortes-Huerto, Lainey Ward, Pietro Ballone</p>
								<p class="pub-journal"><em>The Journal of Physical Chemistry B</em> · Volume 127, Issue 24 · June 2023 · Open Access</p>
								<p class="pub-desc">Molecular dynamics simulations of how thermoresponsive ionic liquids absorb water from the atmosphere, looking at absorption kinetics and the role of nanostructuring.</p>
								<div class="pub-tags">
									<span class="pub-tag">Computational Physics</span>
									<span class="pub-tag">Physical Chemistry</span>
									<span class="pub-tag">Visual Molecular Dynamics</span>
								</div>
								<a class="pub-btn" href="https://pubs.acs.org/doi/10.1021/acs.jpcb.3c01655" target="_blank" rel="noopener">Read paper</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 3. Experience -->
			<section class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>Experience</h2>
				</header>

				<div class="gallery">
					<div class="timeline">
						<div class="timeline-entry">
							<div class="timeline-marker"></div>
							<div class="timeline-content">
								<p class="timeline-date">2025 – 2029</p>
								<div class="timeline-title-row">
									<img class="timeline-logo" src="/assets/logos/ucd.png" alt="UCD logo" loading="lazy" />
									<h4>PhD in AI & Meteorology — University College Dublin</h4>
								</div>
								<p class="timeline-org">School of Civil Engineering · Decarb-AI Programme</p>
								<p class="timeline-grade">Innovate for Ireland iScholar</p>
								<p class="timeline-detail">Machine learning · AI · subseasonal-to-seasonal prediction · multi-hazard events · high-performance computing</p>
							</div>
						</div>
						<div class="timeline-entry">
							<div class="timeline-marker"></div>
							<div class="timeline-content">
								<p class="timeline-date">2025 – present</p>
								<div class="timeline-title-row">
									<img class="timeline-logo" src="/assets/logos/ucd.png" alt="UCD logo" loading="lazy" />
									<h4>Tutor & Demonstrator — University College Dublin</h4>
								</div>
								<p class="timeline-org">School of Civil Engineering</p>
								<p class="timeline-detail">STAT10060 Statistical Modelling · MATH10290 Linear Algebra for Science</p>
							</div>
						</div>
						<div class="timeline-entry">
							<div class="timeline-marker"></div>
							<div class="timeline-content">
								<p class="timeline-date">2024 – 2025</p>
								<div class="timeline-title-row">
									<img class="timeline-logo timeline-logo--wide" src="/assets/logos/met-eireann.png" alt="Met Éireann logo" loading="lazy" />
									<h4>Aeronautical Meteorological Officer — Met Éireann</h4>
								</div>
								<p class="timeline-org">Aeronautical Meteorology Division</p>
								<p class="timeline-detail">Aviation forecasting · observational products · forecast interpretation · <a href="https://rmets.onlinelibrary.wiley.com/doi/10.1002/joc.70185" target="_blank" rel="noopener">volunteer data rescue (acknowledged)</a></p>
							</div>
						</div>
						<div class="timeline-entry">
							<div class="timeline-marker"></div>
							<div class="timeline-content">
								<p class="timeline-date">2023 – 2024</p>
								<div class="timeline-title-row">
									<img class="timeline-logo" src="/assets/logos/reading.png" alt="University of Reading logo" loading="lazy" />
									<h4>MSc Atmosphere, Ocean and Climate — University of Reading</h4>
								</div>
								<p class="timeline-org">Department of Meteorology</p>
								<p class="timeline-grade">Distinction · Dissertation A</p>
								<p class="timeline-detail">Numerical modelling · fluid dynamics · oceanography · weather forecasting · climate change</p>
							</div>
						</div>
						<div class="timeline-entry">
							<div class="timeline-marker"></div>
							<div class="timeline-content">
								<p class="timeline-date">2018 – 2022</p>
								<div class="timeline-title-row">
									<img class="timeline-logo" src="/assets/logos/ucd.png" alt="UCD logo" loading="lazy" />
									<h4>BSc Physics — University College Dublin</h4>
								</div>
								<p class="timeline-org">School of Physics</p>
								<p class="timeline-grade">2:1 · Dissertation A+</p>
								<p class="timeline-detail">Computational physics · advanced laboratory · numerical modelling · data analysis</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 4. Recognition -->
			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>Recognition</h2>
				</header>

				<div class="gallery">
					<div class="impact-cards">
						<div class="impact-card">
							<Icon icon="trophy" color="var(--accent-regular)" size="2rem" />
							<h4>Met Office MSc Dissertation Prize</h4>
							<p>Outstanding research on long-duration storage and meteorological drivers of net-zero electricity systems.</p>
						</div>
						<div class="impact-card">
							<Icon icon="trophy" color="var(--accent-regular)" size="2rem" />
							<h4>UCD Entrance Scholar</h4>
							<p>Awarded on entry to University College Dublin for academic performance.</p>
						</div>
						<div class="impact-card">
							<Icon icon="trophy" color="var(--accent-regular)" size="2rem" />
							<h4>Decarb-AI PhD Scholarship</h4>
							<p>Funded PhD position within Decarbonising Ireland: AI-Powered Pathways to Climate Resilience.</p>
						</div>
						<div class="impact-card">
							<Icon icon="trophy" color="var(--accent-regular)" size="2rem" />
							<h4>COST Action ANTICIPATE (CA24144)</h4>
							<p>Member of the European COST Action network on extended-range and subseasonal multi-hazard prediction and early warning systems.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- 5. Blog -->
			<section class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>Latest from The Ensemble Edit</h2>
					<p>Recent posts from the UCD postgraduate blog I run.</p>
				</header>

				<div class="gallery">
					<div class="blog-cards">
						<a class="blog-card" href="https://the-ensemble-site.vercel.app/blog/when-storms-get-named" target="_blank" rel="noopener">
							<div class="blog-img-wrap">
								<img class="blog-img" src="/assets/blog/when-storms-get-named.jpg" alt="When Do Storms Get Named" loading="lazy" />
							</div>
							<div class="blog-body">
								<span class="blog-track">Research</span>
								<p class="blog-date">Mar 11, 2026</p>
								<h4>When Do Storms Get Named, and Where Do the Names Come From?</h4>
								<p class="blog-excerpt">How storms affecting Ireland get named, who submits them, and why I've already tried to get my own name on the list.</p>
								<span class="blog-read">Read post →</span>
							</div>
						</a>
						<a class="blog-card" href="https://the-ensemble-site.vercel.app/blog/claude-code-new-skill-alert" target="_blank" rel="noopener">
							<div class="blog-img-wrap">
								<img class="blog-img" src="/assets/blog/claude-code-new-skill-alert.png" alt="Claude Code New Skill Alert" loading="lazy" />
							</div>
							<div class="blog-body">
								<span class="blog-track">PhD Tips</span>
								<p class="blog-date">Mar 7, 2026</p>
								<h4>Claude Code: New Skill Alert! (PART I)</h4>
								<p class="blog-excerpt">From ChatGPT copy-paste to agentic assistants: expanding the kitchen with Claude Code.</p>
								<span class="blog-read">Read post →</span>
							</div>
						</a>
						<a class="blog-card" href="https://the-ensemble-site.vercel.app/blog/claude-code-moral-dilemma" target="_blank" rel="noopener">
							<div class="blog-img-wrap">
								<img class="blog-img" src="/assets/blog/claude-code-moral-dilemma.png" alt="Claude Code Moral Dilemma" loading="lazy" />
							</div>
							<div class="blog-body">
								<span class="blog-track">Discussion</span>
								<p class="blog-date">Mar 7, 2026</p>
								<h4>Claude Code: Moral Dilemma Alert! (PART II)</h4>
								<p class="blog-excerpt">Agentic assistants: the vibes are good. The ethics are messier.</p>
								<span class="blog-read">Read post →</span>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!-- 6. Development -->
			<section class="section with-background bg-variant with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>Development</h2>
				</header>

				<div class="gallery">
					<div class="pd-tiles">
						<div class="pd-tile">
							<Icon icon="strategy" color="var(--accent-regular)" size="1.2rem" />
							<h4>ECMWF Anemoi Training</h4>
							<p>AI weather forecasting with AIFS and Anemoi</p>
						</div>
						<div class="pd-tile">
							<Icon icon="terminal-window" color="var(--accent-regular)" size="1.2rem" />
							<h4>ICHEC HPC Training</h4>
							<p>High-performance computing and scalable AI</p>
						</div>
						<div class="pd-tile">
							<Icon icon="rocket-launch" color="var(--accent-regular)" size="1.2rem" />
							<h4>Dragon's Den Competition</h4>
							<p>Entrepreneurship and innovation pitch competition</p>
						</div>
						<div class="pd-tile">
							<Icon icon="sun" color="var(--accent-regular)" size="1.2rem" />
							<h4>UK Met Office Forecasting</h4>
							<p>Operational weather forecasting training</p>
						</div>
						<div class="pd-tile">
							<Icon icon="microphone-stage" color="var(--accent-regular)" size="1.2rem" />
							<h4>ARK Presentation Training</h4>
							<p>Professional presentation and speaking skills</p>
						</div>
						<div class="pd-tile">
							<Icon icon="pencil-line" color="var(--accent-regular)" size="1.2rem" />
							<h4>NextGenEC 2024</h4>
							<p>Dissertation poster presentation at an energy-climate modelling workshop</p>
						</div>
					</div>
				</div>

				<div class="cta">
					<CallToAction href="/development/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.hero-detail {
		color: var(--gray-300);
		font-size: var(--text-md);
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: center 15%;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			justify-content: flex-start;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
			object-position: center 15%;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h2 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h2 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0;
		padding-left: 2rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0.5rem;
		top: 0.75rem;
		bottom: 0.75rem;
		width: 2px;
		background: var(--gray-800);
	}

	.timeline-entry {
		position: relative;
		padding: 0 0 2.5rem 1.5rem;
	}

	.timeline-entry:last-child {
		padding-bottom: 0;
	}

	.timeline-marker {
		position: absolute;
		left: -1.65rem;
		top: 0.55rem;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--accent-regular);
		border: 2px solid var(--gray-999);
		box-shadow: 0 0 0 2px var(--accent-regular);
	}

	.timeline-entry:first-child .timeline-marker {
		animation: marker-pulse 2s ease-in-out infinite;
	}

	@keyframes marker-pulse {
		0%, 100% { box-shadow: 0 0 0 2px var(--accent-regular); }
		50% { box-shadow: 0 0 0 5px var(--accent-overlay); }
	}

	.timeline-content h4 {
		font-size: var(--text-lg);
		color: var(--gray-0);
		margin: 0;
	}

	.timeline-date {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		margin: 0 0 0.25rem;
		font-weight: 600;
	}

	.timeline-org {
		font-size: var(--text-sm);
		color: var(--gray-300);
		margin: 0.25rem 0 0;
	}

	.timeline-grade {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		font-weight: 600;
		margin: 0.15rem 0 0;
	}

	.timeline-detail {
		color: var(--gray-400);
		margin: 0.5rem 0 0;
		font-size: var(--text-md);
	}

	.timeline-detail a {
		color: var(--accent-regular);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.timeline-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.timeline-title-row h4 {
		flex: 1;
		min-width: 0;
	}

	.timeline-logo {
		width: 2rem;
		height: 2rem;
		object-fit: contain;
		flex-shrink: 0;
		border-radius: 0.25rem;
	}

	.timeline-logo--wide {
		width: 3rem;
		height: 2rem;
		border-radius: 0.25rem;
	}

	@media (min-width: 50em) {
		.timeline {
			padding-left: 3rem;
		}

		.timeline::before {
			left: 0.75rem;
		}

		.timeline-marker {
			left: -2.4rem;
			width: 0.875rem;
			height: 0.875rem;
		}

		.timeline-content h4 {
			font-size: var(--text-xl);
		}

		.timeline-logo {
			width: 2.5rem;
			height: 2.5rem;
		}

		.timeline-logo--wide {
			width: 3.75rem;
			height: 2.5rem;
		}
	}

	/* ====================================================== */

	.publications {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.pub-item {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		overflow: hidden;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.pub-img {
		width: 100%;
		height: 12rem;
		object-fit: cover;
		object-position: center center;
		display: block;
	}

	.pub-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.pub-item h4 {
		font-size: var(--text-lg);
		color: var(--gray-0);
		margin: 0;
	}

	.pub-authors {
		font-size: var(--text-sm);
		color: var(--gray-300);
		margin: 0;
	}

	.pub-journal {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0;
	}

	.pub-desc {
		font-size: var(--text-md);
		color: var(--gray-300);
		margin: 0.25rem 0 0;
	}

	.pub-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.5rem 0 0;
	}

	.pub-tag {
		padding: 0.25rem 0.75rem;
		font-size: var(--text-sm);
