---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Development | Lainey Ward" description="Professional training and workshops across AI, meteorology, computing, and communication.">
	<div class="stack gap-20">
		<main class="wrapper dev-page">
			<Hero
				title="Development"
				tagline="Professional training and workshops across AI, meteorology, computing, and communication."
			/>

			<div class="timeline">
				<!-- 2026 -->
				<div class="tl-year-label">2026</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">Anthropic AI Training</h2>
						<p class="tl-org">Anthropic</p>
						<p class="tl-desc">Completed the Claude 101, Claude Code in Action, and AI Fluency for Students certification courses.</p>
						<div class="tl-slides" data-carousel>
							<div class="tl-slide-track">
								<img src="/assets/anthropic-claude-101-certificate.png" alt="Anthropic certificate — Claude 101" loading="lazy" />
								<img src="/assets/anthropic-claude-code-certificate.png" alt="Anthropic certificate — Claude Code in Action" loading="lazy" />
								<img src="/assets/anthropic-ai-fluency-certificate.png" alt="Anthropic certificate — AI Fluency for Students" loading="lazy" />
							</div>
							<div class="tl-dots"></div>
						</div>
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">ANTICIPATE COST Action — 1st General Meeting</h2>
						<p class="tl-org">University of Strathclyde · Glasgow</p>
						<p class="tl-desc">Attending the first general meeting of the ANTICIPATE COST Action (CA24144), bringing together researchers, operational forecasters, and stakeholders to define goals for extended-range multi-hazard prediction and early warning systems.</p>
						<a class="tl-btn" href="https://www.cost.eu/actions/CA24144/" target="_blank" rel="noopener">Visit page</a>
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">Women in Mathematics Poster Exhibition</h2>
						<p class="tl-org">UCD School of Mathematics and Statistics</p>
						<p class="tl-desc">Featured in the UCD School of Mathematics and Statistics International Women's Day poster exhibition highlighting female researchers in the field.</p>
						<a class="tl-btn" href="https://www.ucd.ie/mathstat/womeninmaths/" target="_blank" rel="noopener">Visit page</a>
					</div>
				</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">ARK Speaking & Training</h2>
						<p class="tl-org">ARK Speaking & Training</p>
						<p class="tl-desc">Professional presentation and public speaking training delivered by Eric Fitzpatrick, external trainer at ARK Speaking & Training.</p>
						<div class="tl-slides" data-carousel>
							<div class="tl-slide-track">
								<img src="/assets/slides/ark-training/slide-01.png" alt="ARK training slides — title" loading="lazy" />
								<img src="/assets/slides/ark-training/slide-02.png" alt="ARK training slides — the prediction gap" loading="lazy" />
								<img src="/assets/slides/ark-training/slide-03.png" alt="ARK training slides — how do we forecast at S2S" loading="lazy" />
								<img src="/assets/slides/ark-training/slide-04.png" alt="ARK training slides — why does this approach fail" loading="lazy" />
								<img src="/assets/slides/ark-training/slide-05.png" alt="ARK training slides — Venn diagram" loading="lazy" />
								<img src="/assets/slides/ark-training/slide-06.png" alt="ARK training slides — closing message" loading="lazy" />
							</div>
							<div class="tl-dots"></div>
						</div>
						<p class="tl-caption">Slides prepared for the one-to-one feedback session.</p>
						<a class="tl-btn" href="https://www.arkspeakingandtraining.com/" target="_blank" rel="noopener">Visit page</a>
					</div>
				</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">ML for Earth Systems Modelling — Course 1</h2>
						<p class="tl-org">ECMWF · DestinE Initiative</p>
						<p class="tl-desc">Completed the 10-hour online course on foundations of machine learning in weather and climate science, part of a three-course series developed by ECMWF under the Destination Earth initiative.</p>
					</div>
				</div>

				<!-- 2025 -->
				<div class="tl-year-label">2025</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">Dragon’s Den Competition Programme</h2>
						<p class="tl-org">Decarb-AI Centre</p>
						<p class="tl-desc">Four-day innovation challenge developing an AI concept for energy and climate applications, culminating in a pitch to a panel of judges.</p>
						<div class="tl-slides" data-carousel>
							<div class="tl-slide-track">
								<img src="/assets/slides/agona/slide-01.png" alt="Agona pitch — title" loading="lazy" />
								<img src="/assets/slides/agona/slide-02.png" alt="Agona pitch — agenda" loading="lazy" />
								<img src="/assets/slides/agona/slide-03.png" alt="Agona pitch — the problem" loading="lazy" />
								<img src="/assets/slides/agona/slide-04.png" alt="Agona pitch — the solution" loading="lazy" />
								<img src="/assets/slides/agona/slide-05.png" alt="Agona pitch — capabilities" loading="lazy" />
								<img src="/assets/slides/agona/slide-06.png" alt="Agona pitch — business model" loading="lazy" />
								<img src="/assets/slides/agona/slide-07.png" alt="Agona pitch — market" loading="lazy" />
								<img src="/assets/slides/agona/slide-08.png" alt="Agona pitch — impact" loading="lazy" />
							</div>
							<div class="tl-dots"></div>
						</div>
						<p class="tl-caption">Selected slides from the project presentation.</p>
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">School of Mathematics & Statistics Postgraduate Committee</h2>
						<p class="tl-org">University College Dublin</p>
						<p class="tl-desc">Postgraduate committee member organising PhD seminar series, the postgraduate blog, social events, and academic community activities.</p>
						<img class="tl-card-img" src="/assets/socialcommittee.png" alt="Maths Social Committee banner" loading="lazy" />
					</div>
				</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">AI Climate Sustainability Sandbox</h2>
						<p class="tl-org">Co-Centre for Climate + Biodiversity + Water · Trinity College Dublin</p>
						<p class="tl-desc">Five-day challenge pairing PhD students with industry partners to tackle sustainability problems using AI — our team worked on invasive species detection from satellite imagery.</p>
						<div class="tl-slides" data-carousel>
							<div class="tl-slide-track">
								<img src="/assets/slides/sandbox/slide-01.png" alt="Sandbox presentation — slide 1" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-02.png" alt="Sandbox presentation — slide 2" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-03.png" alt="Sandbox presentation — slide 3" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-04.png" alt="Sandbox presentation — slide 4" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-05.png" alt="Sandbox presentation — slide 5" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-06.png" alt="Sandbox presentation — slide 6" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-07.png" alt="Sandbox presentation — slide 7" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-08.png" alt="Sandbox presentation — slide 8" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-09.png" alt="Sandbox presentation — slide 9" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-10.png" alt="Sandbox presentation — slide 10" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-11.png" alt="Sandbox presentation — slide 11" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-12.png" alt="Sandbox presentation — slide 12" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-13.png" alt="Sandbox presentation — slide 13" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-14.png" alt="Sandbox presentation — slide 14" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-15.png" alt="Sandbox presentation — slide 15" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-16.png" alt="Sandbox presentation — slide 16" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-17.png" alt="Sandbox presentation — slide 17" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-18.png" alt="Sandbox presentation — slide 18" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-19.png" alt="Sandbox presentation — slide 19" loading="lazy" />
								<img src="/assets/slides/sandbox/slide-20.png" alt="Sandbox presentation — slide 20" loading="lazy" />
							</div>
							<div class="tl-dots"></div>
						</div>
						<p class="tl-caption">Selected slides from the project presentation.</p>
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">ICHEC HPC Training</h2>
						<p class="tl-org">ICHEC · University College Dublin</p>
						<p class="tl-desc">Two-day workshop on high-performance computing and scalable AI, covering HPC fundamentals and deploying AI models at scale.</p>
						<img class="tl-card-img" src="/assets/ichec-logo.png" alt="ICHEC — Irish Centre for High-end Computing" loading="lazy" />
					</div>
				</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">IBM AI Foundation Models Workshop</h2>
						<p class="tl-org">IBM Research · Trinity College Dublin</p>
						<p class="tl-desc">Workshop on AI foundation models for weather and climate, with hands-on tutorials for Prithvi WxC, TerraMind, and TerraTorch.</p>
						<div class="tl-slides" data-carousel>
							<div class="tl-slide-track">
								<img src="/assets/ibm-panel.jpeg" alt="IBM Research panel discussion at Trinity College Dublin" loading="lazy" />
								<img src="/assets/ibm-demo.jpeg" alt="Weather visualisation demo at IBM workshop" loading="lazy" />
							</div>
							<div class="tl-dots"></div>
						</div>
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">ECMWF Anemoi Training</h2>
						<p class="tl-org">ECMWF · University College Dublin</p>
						<p class="tl-desc">Three-day training course with the ECMWF team on Anemoi, an open framework for ML-based weather prediction covering data preparation, model training, and inference.</p>
						<img class="tl-card-img" src="/assets/anemoi.jpeg" alt="ECMWF Anemoi training at UCD" loading="lazy" />
					</div>
				</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">UCD Physics Careers Talk</h2>
						<p class="tl-org">UCD School of Physics</p>
						<p class="tl-desc">Spoke on a careers panel for current UCD physics students about routes into meteorology and research.</p>
						<img class="tl-card-img" src="/assets/careers-talk.jpeg" alt="UCD Physics careers panel" loading="lazy" />
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">Intellectual Property Training</h2>
						<p class="tl-org">NovaUCD · University College Dublin</p>
						<p class="tl-desc">Training on managing intellectual property arising from PhD research and routes to commercialisation.</p>
					</div>
				</div>

				<!-- 2024 -->
				<div class="tl-year-label">2024</div>

				<div class="tl-entry reveal tl-left">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">NextGenEC 2024: Energy-Climate Modelling Workshop</h2>
						<p class="tl-org">NextGenEC 2024</p>
						<p class="tl-desc">Presented MSc dissertation research on long-duration storage and meteorological drivers of net-zero electricity systems.</p>
						<img class="tl-card-img" src="/assets/nextgenec.jpeg" alt="NextGenEC 2024 presentation" loading="lazy" />
						<img class="tl-card-img" src="/assets/nextgenec-poster.png" alt="NextGenEC 2024 dissertation poster — Quantifying Long-Duration Storage Capacity and the Meteorological Drivers of Net-Zero Electricity Systems" loading="lazy" />
					</div>
				</div>

				<div class="tl-entry reveal tl-right">
					<div class="tl-marker"></div>
					<div class="tl-card">
						<h2 class="tl-title">UK Met Office Forecasting</h2>
						<p class="tl-org">UK Met Office · University of Reading</p>
						<p class="tl-desc">One-week operational weather forecasting course, applying theoretical knowledge to create tailored forecasts for clients. Achieved distinction.</p>
						<img class="tl-card-img" src="/assets/forecasting-certificate.png" alt="UK Met Office forecasting certificate" loading="lazy" />
					</div>
				</div>
			</div>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<!-- Lightbox modal -->
<div class="lightbox-overlay" id="lightbox" aria-hidden="true">
	<button class="lightbox-close" aria-label="Close lightbox">&times;</button>
	<button class="lightbox-prev" aria-label="Previous slide">&#8249;</button>
	<div class="lightbox-content">
		<img class="lightbox-img" id="lightbox-img" src="" alt="" />
		<p class="lightbox-caption" id="lightbox-caption"></p>
	</div>
	<button class="lightbox-next" aria-label="Next slide">&#8250;</button>
</div>

<style>
	.dev-page {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	/* ====== Central timeline ====== */

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 0 1rem;
	}

	/* Central vertical line */
	.timeline::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--gray-800);
		transform: translateX(-50%);
	}

	/* Year labels */
	.tl-year-label {
		position: relative;
		z-index: 1;
		align-self: center;
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 2rem;
		padding: 0.25rem 1.25rem;
		font-size: var(--text-sm);
		font-weight: 700;
		color: var(--accent-regular);
		margin: 1.5rem 0 1rem;
	}

	.tl-year-label:first-child {
		margin-top: 0;
	}

	/* Entry */
	.tl-entry {
		position: relative;
		width: 48%;
		padding: 0 0 2rem;
	}

	.tl-left {
		align-self: flex-start;
		padding-right: 1.5rem;
	}

	.tl-right {
		align-self: flex-end;
		padding-left: 1.5rem;
	}

	/* Marker dot on the line */
	.tl-marker {
		position: absolute;
		top: 0.75rem;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--accent-regular);
		border: 2px solid var(--gray-999);
		box-shadow: 0 0 0 2px var(--accent-regular);
		z-index: 1;
	}

	.tl-left .tl-marker {
		right: -0.4rem;
	}

	.tl-right .tl-marker {
		left: -0.4rem;
	}

	/* Card */
	.tl-card {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.25rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		transition:
			box-shadow 0.3s ease,
			transform 0.3s ease;
	}

	.tl-card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-3px);
	}

	.tl-title {
		font-size: var(--text-lg);
		color: var(--gray-0);
		margin: 0;
	}

	.tl-org {
		font-size: var(--text-sm);
		color: var(--gray-300);
		margin: 0;
	}

	.tl-desc {
		font-size: var(--text-md);
		color: var(--gray-400);
		margin: 0.25rem 0 0;
	}

	.tl-btn {
		align-self: flex-end;
		margin-top: 0.5rem;
		display: inline-flex;
		place-content: center;
		padding: 0.35em 1.2em;
		font-size: var(--text-sm);
		color: var(--accent-text-over);
		text-decoration: none;
		line-height: 1.1;
		border-radius: 999rem;
		background: var(--gradient-accent-orange);
		box-shadow: var(--shadow-sm);
		white-space: nowrap;
		position: relative;
		overflow: hidden;
	}

	.tl-btn::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: background-color var(--theme-transition);
		mix-blend-mode: overlay;
	}

	.tl-btn:focus::after,
	.tl-btn:hover::after {
		background-color: hsla(var(--gray-999-basis), 0.3);
	}

	/* Slide carousel */
	.tl-slides {
		position: relative;
		overflow: hidden;
		border-radius: 0.5rem;
		background: var(--gray-900);
		margin-top: 0.75rem;
	}

	.tl-slide-track {
		display: flex;
		transition: transform 0.3s ease;
	}

	.tl-slide-track img {
		min-width: 100%;
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		border-radius: 0;
		margin: 0;
		box-shadow: none;
	}

	.tl-dots {
		position: absolute;
		bottom: 0.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.4rem;
	}

	.tl-dots :global(button) {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		border: none;
		background: var(--gray-600);
		padding: 0;
		cursor: pointer;
		transition: background var(--theme-transition);
	}

	.tl-dots :global(button.active) {
		background: var(--accent-regular);
	}

	/* Card images */
	.tl-card-img {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		margin-top: 0.75rem;
		object-fit: cover;
		cursor: pointer;
	}

	/* Slide caption */
	.tl-caption {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0.35rem 0 0;
		font-style: italic;
	}

	/* Clickable slides */
	.tl-slide-track img {
		cursor: pointer;
	}

	/* Lightbox */
	.lightbox-overlay {
		position: fixed;
		inset: 0;
		z-index: 1000;
		background: rgba(0, 0, 0, 0.85);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.lightbox-overlay[aria-hidden="false"] {
		opacity: 1;
		pointer-events: auto;
	}

	.lightbox-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 90vw;
		max-height: 90vh;
	}

	.lightbox-img {
		max-width: 90vw;
		max-height: 85vh;
		object-fit: contain;
		border-radius: 0.5rem;
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
	}

	.lightbox-caption {
		color: rgba(255, 255, 255, 0.7);
		font-size: var(--text-sm);
		font-style: italic;
		margin: 0.75rem 0 0;
		text-align: center;
	}

	.lightbox-caption:empty {
		display: none;
	}

	.lightbox-overlay[data-single="true"] .lightbox-prev,
	.lightbox-overlay[data-single="true"] .lightbox-next {
		display: none;
	}

	.lightbox-close {
		position: absolute;
		top: 1rem;
		right: 1.5rem;
		background: none;
		border: none;
		color: white;
		font-size: 2rem;
		cursor: pointer;
		line-height: 1;
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		transition: background 0.15s ease;
	}

	.lightbox-close:hover {
		background: rgba(255, 255, 255, 0.15);
	}

	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(255, 255, 255, 0.1);
		border: none;
		color: white;
		font-size: 2.5rem;
		cursor: pointer;
		line-height: 1;
		padding: 0.5rem 0.75rem;
		border-radius: 0.375rem;
		transition: background 0.15s ease;
	}

	.lightbox-prev { left: 1rem; }
	.lightbox-next { right: 1rem; }

	.lightbox-prev:hover,
	.lightbox-next:hover {
		background: rgba(255, 255, 255, 0.25);
	}

	/* ====== Mobile: single column ====== */
	@media (max-width: 49.999em) {
		.timeline::before {
			left: 1rem;
		}

		.tl-year-label {
			align-self: flex-start;
			margin-left: 2rem;
		}

		.tl-entry {
			width: 100%;
			padding-left: 3rem;
			padding-right: 0;
		}

		.tl-left,
		.tl-right {
			align-self: stretch;
			padding-left: 3rem;
			padding-right: 0;
		}

		.tl-left .tl-marker,
		.tl-right .tl-marker {
			left: -0.1rem;
			right: auto;
		}
	}

	/* ====== Desktop ====== */
	@media (min-width: 50em) {
		.dev-page {
			display: grid;
			grid-template-columns: 1fr 95% 1fr;
		}

		.dev-page > :global(:first-child) {
			grid-column-start: 2;
		}

		.timeline {
			grid-column-start: 2;
			padding: 0;
		}

		.tl-card {
			padding: 1.5rem;
		}
	}
</style>

<script>
	// Carousel logic
	document.querySelectorAll('[data-carousel]').forEach((carousel) => {
		const track = carousel.querySelector('.tl-slide-track') as HTMLElement;
		const images = track?.querySelectorAll('img') ?? [];
		const dotsContainer = carousel.querySelector('.tl-dots');
		if (!track || images.length === 0 || !dotsContainer) return;

		let current = 0;

		images.forEach((_, i) => {
			const dot = document.createElement('button');
			dot.setAttribute('aria-label', `Slide ${i + 1}`);
			if (i === 0) dot.classList.add('active');
			dot.addEventListener('click', () => goTo(i));
			dotsContainer.appendChild(dot);
		});

		function goTo(index: number) {
			current = index;
			track!.style.transform = `translateX(-${current * 100}%)`;
			dotsContainer!.querySelectorAll('button').forEach((d, i) => {
				d.classList.toggle('active', i === current);
			});
		}

		let timer = setInterval(() => goTo((current + 1) % images.length), 4000);
		carousel.addEventListener('mouseenter', () => clearInterval(timer));
		carousel.addEventListener('mouseleave', () => {
			timer = setInterval(() => goTo((current + 1) % images.length), 4000);
		});
	});

	// Lightbox logic
	const overlay = document.getElementById('lightbox')!;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
	const lightboxCaption = document.getElementById('lightbox-caption')!;
	let lbSlides: HTMLImageElement[] = [];
	let lbIndex = 0;
	let lbCaption = '';

	function showSlide(index: number) {
		lbIndex = (index + lbSlides.length) % lbSlides.length;
		lightboxImg.src = lbSlides[lbIndex].src;
		lightboxImg.alt = lbSlides[lbIndex].alt;
		lightboxCaption.textContent = lbCaption;
	}

	function openLightbox(slides: HTMLImageElement[], startIndex: number, caption: string) {
		lbSlides = slides;
		lbCaption = caption;
		overlay.setAttribute('data-single', slides.length <= 1 ? 'true' : 'false');
		showSlide(startIndex);
		overlay.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	}

	function closeLightbox() {
		overlay.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	// Click on carousel slide images to open lightbox
	document.querySelectorAll('[data-carousel]').forEach((carousel) => {
		const imgs = Array.from(carousel.querySelectorAll('.tl-slide-track img')) as HTMLImageElement[];
		const card = carousel.closest('.tl-card');
		const captionEl = card?.querySelector('.tl-caption');
		const caption = captionEl?.textContent ?? '';
		imgs.forEach((img, i) => {
			img.addEventListener('click', () => openLightbox(imgs, i, caption));
		});
	});

	// Click on single card images to open lightbox
	document.querySelectorAll('.tl-card-img').forEach((img) => {
		const el = img as HTMLImageElement;
		img.addEventListener('click', () => openLightbox([el], 0, ''));
	});

	// Prev / Next buttons
	overlay.querySelector('.lightbox-prev')!.addEventListener('click', () => showSlide(lbIndex - 1));
	overlay.querySelector('.lightbox-next')!.addEventListener('click', () => showSlide(lbIndex + 1));

	// Close on overlay click (but not on image or buttons)
	overlay.addEventListener('click', (e) => {
		if (e.target === overlay) closeLightbox();
	});

	// Close button
	overlay.querySelector('.lightbox-close')!.addEventListener('click', closeLightbox);

	// Keyboard: ESC to close, arrow keys to navigate
	document.addEventListener('keydown', (e) => {
		if (overlay.getAttribute('aria-hidden') === 'true') return;
		if (e.key === 'Escape') closeLightbox();
		if (e.key === 'ArrowLeft') showSlide(lbIndex - 1);
		if (e.key === 'ArrowRight') showSlide(lbIndex + 1);
	});
</script>
